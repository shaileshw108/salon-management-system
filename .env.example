# Application
ENVIRONMENT=development
DEBUG=false
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Database
POSTGRES_PASSWORD=change-this
DATABASE_URL=postgresql+psycopg://salon:change-this@db:5432/salon_queue

# Owner authentication
SECRET_KEY=generate-a-long-random-secret
OWNER_USERNAME=admin
OWNER_PASSWORD=change-this

# SMS notifications
# Keep mock while developing. Use msg91 for real SMS.
SMS_PROVIDER=mock
SMS_NEAR_TURN_THRESHOLD=2
MSG91_AUTHKEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=
MSG91_TIMEOUT_SECONDS=10
